pkgVer <- function(pkg) {
    if (!exists("meta") || is.null(meta)) meta <- packageDescription(pkg)
    ver <- meta$Version
    paste0('https://github.com/mpc-bioinformatics/bppg/', pkg, ' - R package version ', ver)
}

